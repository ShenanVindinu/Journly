<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- Header: back arrow, title, edit and delete -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/journly_blue"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/buttonBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/journly_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Message"
            android:textColor="@color/journly_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/buttonEdit"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Edit message"
            android:src="@drawable/ic_edit"
            app:tint="@color/journly_text" />

        <ImageButton
            android:id="@+id/buttonDelete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete message"
            android:src="@drawable/ic_delete"
            app:tint="@color/journly_text" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Hidden when the message has no photo -->
            <ImageView
                android:id="@+id/imageMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:background="@color/journly_lime"
                android:contentDescription="Attached photo"
                android:maxHeight="360dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/journly_text"
                android:textIsSelectable="true"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#5F5F5F"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textUploaded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:text="Published on Tumblr. Tap to view."
                android:textColor="#1B5E20"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp">

        <Button
            android:id="@+id/buttonShare"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#E0E0E0"
            android:drawableStart="@drawable/ic_share"
            android:drawablePadding="8dp"
            android:drawableTint="@color/journly_text"
            android:text="Share"
            android:textColor="@color/journly_text" />

        <Button
            android:id="@+id/buttonUpload"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/journly_green"
            android:drawableStart="@drawable/ic_upload"
            android:drawablePadding="8dp"
            android:drawableTint="@color/journly_text"
            android:text="Upload to Tumblr"
            android:textColor="@color/journly_text"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>